---
import Layout from '../layouts/Layout.astro';
import Pendiente from '../components/Pendiente.astro';
import Flecha from '../components/Flecha.astro';
import Redes from '../components/Redes.astro';
import Cascada from '../components/Cascada.astro';
import WhatsappFlotante from '../components/WhatsappFlotante.astro';
import { capitulos, cifras, enlaces, evento, whatsapp, ilustraciones, letrero, logo, pendiente, recorrido, productos, sello } from '../data/somos-loja';
const cinta = [...productos, ...productos];
---
<Layout>
	<a class="saltar" href="#tienda">Saltar a la tienda</a>
	<header class="cabecera">
		<a class="cabecera__logo" href="#inicio" aria-label="Somos Loja, volver al inicio"><img src={logo} alt="" width="88" height="120" /></a>
		<nav class="cabecera__nav" aria-label="Navegación principal">
			<a href="#inicio" aria-current="page">Inicio</a>
			<a href="#tienda">Tienda</a>
			<a href="#evento">Evento</a>
		</nav>
		<a class="boton boton--tinta cabecera__lugar" href="#tienda"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.6"/></svg><span>Dónde estamos</span></a>
	</header>

	<main>
		<section id="inicio" class="apertura">
			<div class="apertura__fijo">
				<img class="apertura__rama" src={ilustraciones.rama} alt="" width="800" height="800" />
				<div class="escenario">
					<img class="escenario__img" src={ilustraciones.fachada} srcset={`${ilustraciones.fachadaChica} 900w, ${ilustraciones.fachada} 1672w`} sizes="(max-width: 860px) 100vw, 92vw" alt="Ilustración de la Catedral de Loja con su torre del reloj, palmeras y el Parque Central" width="1672" height="941" fetchpriority="high" />
					<video class="escenario__video" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"></video>
					<div class="titulo">
						<div class="titulo__nombre" aria-label="Somos Loja">
							<p class="firma titulo__somos"><span>Somos</span></p>
							<p class="firma titulo__loja"><span>Loja</span></p>
						</div>
						<h1 class="titulo__lema">El sabor de nuestra tierra, el arte de nuestra gente.</h1>
						<div class="titulo__regla" aria-hidden="true"></div>
					</div>
					<a class="hero-ticket hero-ticket--tienda" href="#tienda">
						<svg class="hero-ticket__icono" viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M8 16h32l-2 26H10L8 16Z M17 19v-8a7 7 0 0 1 14 0v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
						<span class="hero-ticket__titulo">Tienda</span>
						<span class="hero-ticket__regla" aria-hidden="true">✻</span>
						<span class="hero-ticket__accion">Conoce la tienda</span>
					</a>
					<a class="hero-ticket hero-ticket--evento" href="#evento">
						<span class="hero-ticket__sello" aria-hidden="true">Loja<br />✦<br />Café</span>
						<span class="hero-ticket__etiqueta">Evento</span>
						<span class="hero-ticket__titulo"><strong>{cifras.marcasEvento}</strong> marcas<br />de café</span>
						<span class="hero-ticket__regla" aria-hidden="true">✻</span>
						<span class="hero-ticket__accion">Ver evento</span>
					</a>
				</div>
				<img class="apertura__grano" src={ilustraciones.grano} alt="" width="900" height="900" />
				<h2 class="titular apertura__frase">En Loja, cada grano<br />tiene una historia</h2>
			</div>
		</section>

		<section id="proceso" class="proceso" aria-label="El camino del café">
			<svg class="cinta" viewBox="0 0 1000 2400" preserveAspectRatio="none" aria-hidden="true">
				<path class="cinta__ancha" d="M500 0C820 240 900 520 620 760S120 1040 240 1320 860 1560 780 1880 420 2240 500 2400" />
				<path class="cinta__fina" d="M520 0C860 240 930 540 640 780S150 1060 270 1330 890 1580 800 1890 450 2240 520 2400" />
			</svg>
			{capitulos.map((c, i) => (
				<article class={`capitulo capitulo--${i % 2 ? 'der' : 'izq'}${c.img ? '' : ' capitulo--solo-fotos'}`}>
					<figure class="capitulo__marco">
						{c.img && <img class="capitulo__img" src={c.img} alt={c.alt} width={c.ancho} height={c.alto} loading="lazy" decoding="async" />}
						{c.fotos.map((foto, k) => (
							<img class={`capitulo__foto capitulo__foto--${k + 1}`} src={foto.src} srcset={`${foto.src.replace('.webp', '-600.webp')} 600w, ${foto.src} ${foto.ancho}w`} sizes="(max-width: 860px) 70vw, 34vw" alt={foto.alt} width={foto.ancho} height={foto.alto} loading="lazy" decoding="async" />
						))}
						<span class="capitulo__sello" aria-hidden="true"><b>N.º {i + 1}</b>Foto real</span>
					</figure>
					<div class="capitulo__texto">
						<h2 class="titular">{c.titulo}</h2>
						<p class="cuerpo">{c.texto}</p>
					</div>
				</article>
			))}
		</section>

		<Cascada />

		<section id="evento" class="cincuenta">
			<div class="cincuenta__fijo">
				<canvas id="granos" aria-hidden="true"></canvas>
				<p class="cincuenta__respaldo" aria-hidden="true">50</p>
			</div>
			<div class="cincuenta__capa">
				<div class="cincuenta__texto">
					<h2 class="titular">{evento.nombre}: diez días en la tienda</h2>
					<p class="cuerpo">Unas {cifras.marcasEvento} marcas participan: filtrados, V60 y concurso de chuspas. Las marcas compiten y eligen su top 10 de especialidad. Y todo el año, la tienda reúne {cifras.marcasTienda} marcas de café.</p>
					<div class="cincuenta__ficha">
						<img class="cincuenta__sello" src={sello} alt="Sello del evento, Somos Loja Coopser, tercera edición" width="640" height="610" loading="lazy" decoding="async" />
						<dl>
							<div><dt>Cuándo</dt><dd>{evento.fechas}</dd></div>
							<div><dt>Dónde</dt><dd>{evento.lugar}<span>{evento.esquina}</span></dd></div>
							{evento.hora && <div><dt>Hora</dt><dd>{evento.hora}</dd></div>}
						</dl>
					</div>
					<div class="cincuenta__acciones">
						<a class="boton boton--tinta" href={evento.postal}>Abrir la invitación<Flecha /></a>
						<a class="boton boton--linea" href={evento.mapa} target="_blank" rel="noopener">Cómo llegar a la tienda</a>
						<a class="enlace-wa" href={whatsapp.evento} target="_blank" rel="noopener">Pregúntanos por el evento</a>
					</div>
				</div>
			</div>
		</section>

		<section id="tienda" class="tienda">
			<div class="tienda__rejilla">
				<div class="tienda__texto">
					<h2 class="titular">A pasos de la Catedral de Loja</h2>
					<p class="tienda__resumen">La cooperativa reúne a <strong>{cifras.socios}</strong> emprendedores lojanos y productores de la EPS. Contamos con <strong>{cifras.marcasTienda}</strong> marcas de café y una amplia oferta de productos de agroindustria, textiles, artesanías, licores, salud y belleza.</p>
					<ul class="tienda__datos">
						<li>
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.4" /></svg>
							<span>{pendiente.direccion ?? <Pendiente dato="direccion" />}</span>
						</li>
						<li>
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 3.5h3l1.4 4.2-2 1.3a12 12 0 0 0 6 6l1.3-2 4.2 1.4v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z" /></svg>
							<span><a class="tienda__tel" href={`tel:${enlaces.telefono}`}>{enlaces.telefonoVisible}</a> {pendiente.horario ?? <Pendiente dato="horario" />}</span>
						</li>
					</ul>
					<div class="tienda__acciones">
						<a class="boton boton--ocre" href={enlaces.mapa} target="_blank" rel="noopener">Cómo llegar a la tienda<Flecha /></a>
						<Redes />
						<a class="enlace-wa enlace-wa--claro" href={whatsapp.tienda} target="_blank" rel="noopener">Escríbenos por WhatsApp</a>
					</div>
				</div>
				<figure class="mapa" data-vista="mapa">
					<div class="mapa__vista">
					<iframe
						class="mapa__lienzo"
						src="https://www.google.com/maps?q=TIENDA%20SOMOS%20LOJA%2C%20Loja%2C%20Ecuador&z=17&hl=es&output=embed"
						title="Ubicación de Tienda Somos Loja en el mapa"
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen
					></iframe>
					<div class="mapa__recorrido" aria-hidden="true">
						<video aria-label="Recorrido a pie desde la Catedral hasta la tienda" muted playsinline preload="none" poster={recorrido.poster} data-tramo={recorrido.tramo} data-completo={recorrido.src} width="1120" height="700"></video>
						<p class="mapa__ubicacion"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z" /><circle cx="12" cy="10" r="2.6" /></svg>Frente al Parque Central</p>
						<button type="button" class="mapa__completo">Ver todo el recorrido</button>
					</div>
					</div>
					<div class="mapa__selector" role="group" aria-label="Ver la ubicación">
						<button type="button" data-ver="mapa" aria-pressed="true">Mapa</button>
						<button type="button" data-ver="recorrido" aria-pressed="false">Cómo se llega</button>
					</div>
				</figure>
				<figure class="foto foto--letrero"><img src={letrero} alt="Letrero de Somos Loja sobre los estantes de la tienda" width="1024" height="576" loading="lazy" decoding="async" /></figure>
			</div>
			<div class="carrusel" tabindex="0" aria-label="Algunos productos de la tienda">
				<ul class="carrusel__pista">
					{cinta.map((p, i) => (
						<li class="producto" aria-hidden={i >= productos.length ? 'true' : undefined}>
							<img src={p.src} srcset={`${p.src.replace('.webp', '-400.webp')} 400w, ${p.src} 800w`} sizes="200px" alt={i >= productos.length ? '' : p.alt} width="800" height="1067" loading="eager" fetchpriority="low" decoding="async" />
							<h3>{p.titulo}</h3>
						</li>
					))}
				</ul>
			</div>
		</section>
	</main>

	<!-- Scroll cue: fixed at the bottom edge on every section; it always points to the next one. -->
	<a class="apertura__seguir" href="#proceso"><span aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg></span>Explora Loja</a>
	<WhatsappFlotante />

	<footer class="pie">
		<img src={logo} alt="Somos Loja Tienda" width="56" height="56" loading="lazy" />
		<p class="pie__invitacion">Te esperamos a pasos de la Catedral.</p>
		<p>Somos Loja, Coopser. Productos de emprendedores y productores locales.</p>
		<p class="pie__contacto"><a href={`tel:${enlaces.telefono}`}>{enlaces.telefonoVisible}</a> · <a href={whatsapp.general} target="_blank" rel="noopener">WhatsApp</a> · <a href={enlaces.mapa} target="_blank" rel="noopener">Cómo llegar</a></p>
		<p class="pie__credito">© 2026 · Desarrollado por <a href="https://strawhatcode.com" target="_blank" rel="noopener">Straw Hat Code <span aria-hidden="true">👒</span></a></p>
	</footer>
</Layout>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import Lenis from 'lenis';
	import { iniciarCascada } from '../scripts/cascada-taza.js';
	import { crearBloqueo } from '../scripts/bloqueo-scroll.js';
	import { iniciarMapa } from '../scripts/mapa-rotacion.js';

	const reducir = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const ahorro = (navigator as any).connection?.saveData;
	const movil = innerWidth <= 860;
	gsap.registerPlugin(ScrollTrigger);
	// The address bar showing or hiding must not re-measure every scene mid-scroll.
	ScrollTrigger.config({ ignoreMobileResize: true });

	if (!reducir) {
		document.documentElement.classList.add('animado');
		// A hard wheel flick is capped per event, so one shove cannot fly past several scenes.
		const lenis = new Lenis({
			lerp: 0.085, wheelMultiplier: 0.85,
			virtualScroll: (d) => { if (d.event.type === 'wheel') d.deltaY = Math.max(-140, Math.min(140, d.deltaY)); return true; }
		});
		window.addEventListener('evento:abrir', () => lenis.stop());
		window.addEventListener('evento:cerrar', () => lenis.start());
		lenis.on('scroll', ScrollTrigger.update);
		gsap.ticker.add((s) => lenis.raf(s * 1000));
		gsap.ticker.lagSmoothing(0);
		// A short hold while the hero bean falls, so a quick double scroll cannot skip it.
		const bloqueo = crearBloqueo(lenis);
		let navegando = false;
		document.querySelectorAll('a[href^="#"]').forEach((a) => a.addEventListener('click', (e) => {
			e.preventDefault();
			const destino = document.querySelector<HTMLElement>(a.getAttribute('href')!);
			if (!destino) return;
			// A menu trip is never held back by the hero hold.
			bloqueo.liberar();
			navegando = true;
			setTimeout(() => { navegando = false; }, 2200);
			// Keyboard focus follows the smooth scroll, as a native anchor jump would.
			lenis.scrollTo(destino, { duration: 1.6, onComplete: () => {
				navegando = false;
				if (!destino.hasAttribute('tabindex')) destino.setAttribute('tabindex', '-1');
				destino.focus({ preventScroll: true });
				history.replaceState(null, '', a.getAttribute('href'));
			} });
		}));

		// Opening: the name is written by hand, then the rest settles in.
		gsap.timeline({ defaults: { ease: 'power2.out' } })
			// Scale only: the illustration is the LCP and must paint before the JS runs.
			.from('.escenario__img', { scale: 1.03, duration: 1.2 }, 0)
			.fromTo('.titulo__somos span', { clipPath: 'inset(-20% 100% -20% 0)' }, { clipPath: 'inset(-20% -5% -20% 0)', duration: 0.9, ease: 'power1.inOut' }, 0.2)
			.fromTo('.titulo__loja span', { clipPath: 'inset(-20% 100% -20% 0)' }, { clipPath: 'inset(-20% -5% -20% 0)', duration: 0.7, ease: 'power1.inOut' }, 1)
			.from('.titulo__lema', { autoAlpha: 0, y: 16, duration: 0.6 }, 1.5)
			.from('.hero-ticket', { autoAlpha: 0, y: 16, duration: 0.6, stagger: 0.12 }, 1.65);
		gsap.to('.apertura__rama', { rotate: 3, duration: 3.2, ease: 'sine.inOut', yoyo: true, repeat: -1, transformOrigin: '0% 0%' });

		// A living cathedral, only where it costs little.
		const video = document.querySelector<HTMLVideoElement>('.escenario__video');
		const urlVideo = document.documentElement.dataset.video;
		if (video && urlVideo && !movil && !ahorro) {
			video.src = urlVideo;
			video.addEventListener('canplay', () => { video.classList.add('listo'); video.play().catch(() => {}); }, { once: true });
			video.load();
			new IntersectionObserver(([e]) => { if (e.isIntersecting) video.play().catch(() => {}); else video.pause(); }).observe(video);
		}

		// Scroll: the square gives way to one large bean. A small scroll plays the whole fall by
		// time, so the bean never hangs halfway over the cathedral; scrolling back to the top rewinds it.
		const caida = gsap.timeline({ paused: true, defaults: { ease: 'none' } });
		let caidaTween: gsap.core.Tween | null = null;
		const caidaHacia = (fin: number, segundos: number) => {
			caidaTween?.kill();
			const resto = Math.abs(fin - caida.progress());
			if (resto < 0.001) return;
			caidaTween = caida.tweenTo(fin * caida.duration(), { duration: segundos * resto, ease: 'power2.inOut' });
		};
		ScrollTrigger.create({
			trigger: '.apertura', start: 'top -2%', end: 'bottom bottom',
			onEnter: () => caidaHacia(1, 1.6),
			// No hold: a fast flick only hurries the fall, so the bean always lands before the hero leaves.
			onUpdate: (self) => {
				if (self.direction < 0 || self.progress <= caida.progress() + 0.02) return;
				caidaTween?.kill();
				caida.progress(Math.min(1, self.progress));
				caidaHacia(1, 1.6);
			},
			onLeaveBack: () => caidaHacia(0, 1),
			onRefresh: (self) => { if (self.scroll() > self.start) { caidaTween?.kill(); caida.progress(1); } }
		});
		caida
			.to('.titulo', { y: -90, autoAlpha: 0, duration: 0.18 }, 0.7)
			.to('.apertura__rama', { x: -120, y: -120, autoAlpha: 0, duration: 0.2 }, 0.7)
			// The cathedral zooms in from its base (no gap opens below it), then fades as the bean lands.
			.to('.escenario', { scale: 1.18, duration: 0.6, transformOrigin: '50% 100%' }, 0)
			.to('.escenario', { autoAlpha: 0, scale: 1.26, duration: 0.25 }, 0.5)
			.fromTo('.apertura__grano', { yPercent: -180, rotate: -50, scale: 0.55 }, { yPercent: 0, rotate: 18, scale: 1, duration: 0.65 }, 0)
			// The headline's CSS bottom already clears the "Explora Loja" pill that stays on screen.
			.fromTo('.apertura__frase', { autoAlpha: 0, y: 40 }, { autoAlpha: 1, y: 0, duration: 0.2 }, 0.55)
			.to('.apertura__grano', { rotate: 40, duration: 0.3 }, 0.65);

		// The coffee ribbon draws itself through three alternating chapters.
		gsap.utils.toArray<SVGPathElement>('.cinta path').forEach((p) => {
			const largo = p.getTotalLength();
			// The ribbon is already flowing when the chapters arrive (a visible lead-in, not a dot)
				// and keeps drawing from the moment the section enters the screen.
				gsap.fromTo(p, { strokeDasharray: largo, strokeDashoffset: largo * 0.84 }, { strokeDashoffset: 0, ease: 'none', scrollTrigger: { trigger: '.proceso', start: 'top bottom', end: movil ? 'bottom 85%' : 'bottom 75%', scrub: true } });
		});
		gsap.utils.toArray<HTMLElement>('.capitulo').forEach((c) => {
			const dibujo = c.querySelector('.capitulo__img');
			if (dibujo) gsap.from(dibujo, { autoAlpha: 0, scale: 0.94, y: 48, duration: 0.9, ease: 'power3.out', scrollTrigger: { trigger: c, start: 'top 72%' } });
			gsap.from(c.querySelector('.capitulo__texto'), { autoAlpha: 0, y: 32, duration: 0.8, delay: 0.1, ease: 'power3.out', scrollTrigger: { trigger: c, start: movil ? 'top 88%' : 'top 85%' } });
			// "Del dibujo a la foto": the real print develops from the paper while scrolling.
			// Mobile: the print develops by itself as soon as the chapter peeks in, so the visitor never
				// scrolls through an empty frame waiting for a scrubbed reveal.
				const revelado = gsap.timeline(movil
					? { scrollTrigger: { trigger: c, start: 'top 92%', toggleActions: 'play none none reverse' }, defaults: { duration: 0.8 } }
					: { scrollTrigger: { trigger: c, start: 'top 95%', end: 'top 30%', scrub: 0.6 } });
			c.querySelectorAll('.capitulo__foto').forEach((foto, k) => {
				revelado.fromTo(foto, { clipPath: 'inset(100% 0% 0% 0%)', y: 64, scale: 1.05 }, { clipPath: 'inset(0% 0% 0% 0%)', y: 0, scale: 1, ease: movil ? 'power3.out' : 'none', duration: movil ? 0.9 : 1 }, k * (movil ? 0.25 : 0.4));
			});
			if (dibujo) revelado.to(dibujo, { opacity: 0.62, scale: 0.97, ease: 'none', duration: 1 }, 0);
			revelado.fromTo(c.querySelector('.capitulo__sello'), { autoAlpha: 0, scale: 1.8 }, { autoAlpha: 1, scale: 1, ease: 'back.out(2.2)', duration: 0.35 }, '>-0.1');
		});

		// Cascade: the bean falls and the cup fills.
		iniciarCascada(gsap, ScrollTrigger);

		// The 50: scroll drives real 3D beans.
		const etapa = document.querySelector<HTMLElement>('.cincuenta')!;
		const canvas = document.getElementById('granos') as HTMLCanvasElement | null;
		// Mobile: once the section arrives, the 50 finishes forming on its own in 1.6 s, so it never
		// freezes half built when the visitor stops scrolling; scrolling back above it resets it.
		const formacion = { v: 0 };
		let lanzada = false;
		function progreso() {
			const r = etapa.getBoundingClientRect();
			const recorrido = movil ? innerHeight : (r.height - innerHeight) * 0.7 + innerHeight * 0.6;
			const p = Math.min(1, Math.max(0, (innerHeight * 0.6 - r.top) / recorrido));
			if (!movil) return p;
			if (p > 0.05 && !lanzada) { lanzada = true; gsap.to(formacion, { v: 1, duration: 1.6, ease: 'none' }); }
			else if (p === 0 && lanzada) { lanzada = false; gsap.killTweensOf(formacion); formacion.v = 0; }
			return formacion.v;
		}
		// Leaving the finished cup downwards: a short hold glides the page to the 50, fully built.
		ScrollTrigger.create({
			trigger: '.cascada', start: 'top top', end: 'bottom bottom',
			onLeave: (self) => {
				const caja = etapa.getBoundingClientRect();
				// Only a real scroll from the cup; a reload further down or a menu trip is left alone.
				if (navegando || self.getVelocity() <= 0 || caja.top <= 0 || caja.top > innerHeight * 1.2) return;
				const destino = scrollY + caja.top + (movil ? 0 : (etapa.offsetHeight - innerHeight) * 0.7);
				const segundos = movil ? 1 : 1.8;
				// Phones: the 50 then finishes forming by itself, so the hold lasts until it is done.
				bloqueo.bloquear((segundos + (movil ? 1.6 : 0.3)) * 1000);
				lenis.scrollTo(destino, {
					duration: segundos, force: true,
					easing: (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2),
					// A beat on the finished 50 before the page is free again.
					onComplete: () => { if (!movil) setTimeout(() => bloqueo.liberar(), 400); }
				});
			}
		});
		if (canvas && !ahorro) {
			const vigia = new IntersectionObserver(([e]) => {
				if (!e.isIntersecting) return;
				vigia.disconnect();
				const acuarela = new URLSearchParams(location.search).get('granos') === 'acuarela';
				import(acuarela ? '../scripts/granos-acuarela.js' : '../scripts/granos-vintage.js')
					.then((m) => m.iniciarGranos(canvas, document.querySelector('.cincuenta__fijo')!, progreso))
					.then(() => document.documentElement.classList.add('con-granos'))
					.catch(() => canvas.remove());
			}, { rootMargin: '120% 0px' });
			vigia.observe(etapa);
		}
		// The text is read while the 50 forms: each block arrives in turn and the last
		// one lands exactly when progreso() reaches 1, the moment the beans settle.
		// Driven by hand from the trigger progress: a staggered scrub timeline leaves the
		// blocks that have not started yet visible after ScrollTrigger.refresh().
		const bloques = gsap.utils.toArray<HTMLElement>('.cincuenta__texto > *');
		const paso = 0.75;
		const total = 1 + paso * (bloques.length - 1);
		const leer = (avance: number) => bloques.forEach((b, i) => {
			const k = gsap.utils.clamp(0, 1, avance * total - i * paso);
			gsap.set(b, { autoAlpha: k, y: 32 * (1 - k) });
		});
		// Desktop only: on mobile the text is a sheet that scrolls over the finished 50.
		if (!movil) leer(0);
		if (!movil) ScrollTrigger.create({ trigger: etapa, start: 'top 30%', end: () => 'top+=' + (etapa.offsetHeight - innerHeight) * 0.7 + ' top', invalidateOnRefresh: true, onUpdate: (self) => leer(self.progress), onRefresh: (self) => leer(self.progress) });

		// Store.
		gsap.from('.tienda__texto > *', { autoAlpha: 0, y: 24, duration: 0.7, stagger: 0.06, ease: 'power3.out', scrollTrigger: { trigger: '.tienda', start: 'top 68%' } });
		gsap.from('.mapa, .foto', { autoAlpha: 0, y: 48, duration: 0.9, stagger: 0.1, ease: 'power3.out', scrollTrigger: { trigger: '.tienda__rejilla', start: 'top 70%' } });
		addEventListener('load', () => ScrollTrigger.refresh());
	}

	// Header turns petrol while the store section sits under it.
	const cabecera = document.querySelector<HTMLElement>('.cabecera');
	const tienda = document.querySelector<HTMLElement>('.tienda');
	if (cabecera && tienda) {
		new IntersectionObserver(([e]) => cabecera.classList.toggle('cabecera--oscura', e.isIntersecting), {
			rootMargin: `0px 0px -${Math.max(0, innerHeight - 64)}px 0px`,
		}).observe(tienda);
	}

	// The fixed "Explora Loja" cue always leads to the next section and leaves once the store is reached.
	const seguir = document.querySelector<HTMLAnchorElement>('.apertura__seguir');
	const paradas = ['#proceso', '#taza', '#evento', '#tienda'].map((id) => document.querySelector<HTMLElement>(id)).filter(Boolean) as HTMLElement[];
	if (seguir && paradas.length) {
		let pendiente = 0;
		const apuntar = () => {
			pendiente = 0;
			const siguiente = paradas.find((p) => p.getBoundingClientRect().top > innerHeight * 0.35);
			seguir.classList.toggle('apertura__seguir--fin', !siguiente);
			if (siguiente) seguir.setAttribute('href', `#${siguiente.id}`);
		};
		addEventListener('scroll', () => { if (!pendiente) pendiente = requestAnimationFrame(apuntar); }, { passive: true });
		apuntar();
	}

	// Header steps aside while reading down and returns on any upward scroll, so the logo never
	// sits on top of the scenes below the hero.
	if (cabecera) {
		let ultimo = scrollY;
		addEventListener('scroll', () => {
			const y = scrollY;
			if (Math.abs(y - ultimo) < 6) return;
			cabecera.classList.toggle('cabecera--oculta', y > ultimo && y > innerHeight * 0.6 && !cabecera.contains(document.activeElement));
			ultimo = y;
		}, { passive: true });
	}

	// Store location: map and walk clip take turns (src/scripts/mapa-rotacion.js).
	const marco = document.querySelector<HTMLElement>('.mapa');
	if (marco) iniciarMapa(marco, { reducir, ahorro });
</script>
