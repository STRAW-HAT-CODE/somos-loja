---
import Layout from '../layouts/Layout.astro';
import Pendiente from '../components/Pendiente.astro';
import Flecha from '../components/Flecha.astro';
import Invitacion from '../components/Invitacion.astro';
import Cascada from '../components/Cascada.astro';
import { capitulos, cifras, enlaces, ilustraciones, interior, letrero, logo, pendiente, productos, sello } from '../data/somos-loja';
const cinta = [...productos, ...productos];
---
<Layout>
	<a class="saltar" href="#tienda">Saltar a la tienda</a>
	<header class="cabecera">
		<a class="cabecera__logo" href="#inicio" aria-label="Somos Loja, volver al inicio"><img src={logo} alt="" width="88" height="120" /></a>
		<nav class="cabecera__nav" aria-label="Navegación principal">
			<a href="#inicio" aria-current="page">Inicio</a>
			<a href="#tienda">Tienda</a>
			<a href="#evento">Evento</a>
		</nav>
		<a class="boton boton--tinta cabecera__lugar" href="#tienda"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.6"/></svg><span>Dónde estamos</span></a>
	</header>

	<main>
		<section id="inicio" class="apertura">
			<div class="apertura__fijo">
				<img class="apertura__rama" src={ilustraciones.rama} alt="" width="800" height="800" fetchpriority="high" />
				<div class="escenario">
					<img class="escenario__img" src={ilustraciones.fachada} alt="Ilustración de la Catedral de Loja con su torre del reloj, palmeras y el Parque Central" width="1672" height="941" fetchpriority="high" />
					<video class="escenario__video" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"></video>
					<div class="titulo">
						<div class="titulo__nombre" aria-label="Somos Loja">
							<p class="firma titulo__somos"><span>Somos</span></p>
							<p class="firma titulo__loja"><span>Loja</span></p>
						</div>
						<h1 class="titulo__lema">El sabor de nuestra tierra, el arte de nuestra gente.</h1>
						<div class="titulo__regla" aria-hidden="true"></div>
					</div>
					<a class="hero-ticket hero-ticket--tienda" href="#tienda">
						<svg class="hero-ticket__icono" viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M8 16h32l-2 26H10L8 16Z M17 19v-8a7 7 0 0 1 14 0v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
						<span class="hero-ticket__titulo">Tienda</span>
						<span class="hero-ticket__regla" aria-hidden="true">✻</span>
						<span class="hero-ticket__accion">Conoce la tienda</span>
					</a>
					<a class="hero-ticket hero-ticket--evento" href="#evento">
						<span class="hero-ticket__sello" aria-hidden="true">Loja<br />✦<br />Café</span>
						<span class="hero-ticket__etiqueta">Evento</span>
						<span class="hero-ticket__titulo"><strong>+50</strong> marcas<br />de café</span>
						<span class="hero-ticket__regla" aria-hidden="true">✻</span>
						<span class="hero-ticket__accion">Ver evento</span>
					</a>
				</div>
				<img class="apertura__grano" src={ilustraciones.grano} alt="" width="900" height="900" />
				<h2 class="titular apertura__frase">En Loja, cada grano<br />tiene una historia</h2>
				<a class="apertura__seguir" href="#proceso"><span aria-hidden="true">⌄</span>Explora Loja</a>
			</div>
		</section>

		<section id="proceso" class="proceso" aria-label="El camino del café">
			<svg class="cinta" viewBox="0 0 1000 2400" preserveAspectRatio="none" aria-hidden="true">
				<path class="cinta__ancha" d="M500 0C820 240 900 520 620 760S120 1040 240 1320 860 1560 780 1880 420 2240 500 2400" />
				<path class="cinta__fina" d="M520 0C860 240 930 540 640 780S150 1060 270 1330 890 1580 800 1890 450 2240 520 2400" />
			</svg>
			{capitulos.map((c, i) => (
				<article class={`capitulo capitulo--${i % 2 ? 'der' : 'izq'}${c.img ? '' : ' capitulo--solo-fotos'}`}>
					<figure class="capitulo__marco">
						{c.img && <img class="capitulo__img" src={c.img} alt={c.alt} width={c.ancho} height={c.alto} loading="lazy" decoding="async" />}
						{c.fotos.map((foto, k) => (
							<img class={`capitulo__foto capitulo__foto--${k + 1}`} src={foto.src} alt={foto.alt} width={foto.ancho} height={foto.alto} loading="lazy" decoding="async" />
						))}
						<span class="capitulo__sello" aria-hidden="true"><b>N.º {i + 1}</b>Foto real</span>
					</figure>
					<div class="capitulo__texto">
						<h2 class="titular">{c.titulo}</h2>
						<p class="cuerpo">{c.texto}</p>
					</div>
				</article>
			))}
		</section>

		<Cascada />

		<section id="evento" class="cincuenta">
			<div class="cincuenta__fijo">
				<canvas id="granos" aria-hidden="true"></canvas>
				<p class="cincuenta__respaldo" aria-hidden="true">50</p>
				<div class="cincuenta__texto">
					<h2 class="titular"><span class="sr-only">Más de 50 </span>marcas y fincas de café</h2>
					<p class="cuerpo">En Loja 100 % Café Especial, un campeonato interno elige el top 10 de especialidad. Son 10 días de filtrados, V60 y concurso de chuspas.</p>
					<p class="cincuenta__evento"><img src={sello} alt="Sello 100 % Café Especial, Somos Loja Coopser, tercera edición" width="640" height="610" loading="lazy" decoding="async" />{pendiente.fecha ?? <Pendiente dato="fecha" />}</p>
				</div>
			</div>
		</section>

		<Invitacion />

		<section id="tienda" class="tienda">
			<div class="tienda__rejilla">
				<div class="tienda__texto">
					<p class="firma firma--clara">Aquí estamos</p>
					<h2 class="titular">A pasos de la Catedral de Loja</h2>
					<p class="cuerpo">Somos Loja es la cooperativa que reúne el trabajo de emprendedores y productores lojanos, en el centro de la ciudad.</p>
					<p class="cuerpo">{pendiente.direccion ?? <Pendiente dato="direccion" />}. <a class="tienda__tel" href={`tel:${enlaces.telefono}`}>{enlaces.telefonoVisible}</a> {pendiente.horario ?? <Pendiente dato="horario" />}</p>
					<ul class="cifras">
						{cifras.map(([n, d]) => <li><strong>{n}</strong><span>{d}</span></li>)}
					</ul>
					<div class="tienda__acciones">
						<a class="boton boton--ocre" href={enlaces.mapa} target="_blank" rel="noopener">Cómo llegar a la tienda<Flecha /></a>
						<a class="boton boton--clara" href={enlaces.instagram} target="_blank" rel="noopener">Instagram</a>
						{pendiente.facebook ?? <Pendiente dato="facebook" />}
						{pendiente.tiktok ?? <Pendiente dato="tiktok" />}
					</div>
				</div>
				<figure class="mapa">
					<iframe
						class="mapa__lienzo"
						src="https://www.google.com/maps?q=TIENDA%20SOMOS%20LOJA%2C%20Loja%2C%20Ecuador&z=17&hl=es&output=embed"
						title="Ubicación de Tienda Somos Loja en el mapa"
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen
					></iframe>
					<figcaption class="nota">Tienda Somos Loja, José Antonio Eguiguren y Bernardo Valdivieso, frente al Parque Central. Arrastrá el mapa para explorar o usá «Cómo llegar».</figcaption>
				</figure>
				<figure class="foto foto--interior"><img src={interior} alt="Interior de la tienda Somos Loja con una vitrina llena de productos" width="1200" height="1600" loading="lazy" decoding="async" /></figure>
				<figure class="foto foto--letrero"><img src={letrero} alt="Letrero de Somos Loja sobre los estantes de la tienda" width="1024" height="576" loading="lazy" decoding="async" /></figure>
			</div>
			<div class="carrusel" tabindex="0" aria-label="Algunos productos de la tienda">
				<ul class="carrusel__pista">
					{cinta.map((p, i) => (
						<li class="producto" aria-hidden={i >= productos.length ? 'true' : undefined}>
							<img src={p.src} alt={i >= productos.length ? '' : p.alt} width="800" height="1067" loading="lazy" decoding="async" />
							<h3>{p.titulo}</h3>
						</li>
					))}
				</ul>
			</div>
		</section>
	</main>

	<footer class="pie">
		<img src={logo} alt="Somos Loja Tienda" width="56" height="56" loading="lazy" />
		<p>Somos Loja, Coopser. Productos de emprendedores y productores locales.</p>
		<Pendiente dato="enlaces legales" />
	</footer>
</Layout>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import Lenis from 'lenis';
	import { iniciarCascada } from '../scripts/cascada-taza.js';

	const reducir = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const ahorro = (navigator as any).connection?.saveData;
	const movil = innerWidth <= 860;
	gsap.registerPlugin(ScrollTrigger);

	if (!reducir) {
		document.documentElement.classList.add('animado');
		const lenis = new Lenis({ lerp: 0.085, wheelMultiplier: 0.85 });
		window.addEventListener('evento:abrir', () => lenis.stop());
		window.addEventListener('evento:cerrar', () => lenis.start());
		lenis.on('scroll', ScrollTrigger.update);
		gsap.ticker.add((s) => lenis.raf(s * 1000));
		gsap.ticker.lagSmoothing(0);
		document.querySelectorAll('a[href^="#"]').forEach((a) => a.addEventListener('click', (e) => {
			e.preventDefault();
			lenis.scrollTo(a.getAttribute('href')!, { duration: 1.6 });
		}));

		// Opening: the name is written by hand, then the rest settles in.
		gsap.timeline({ defaults: { ease: 'power2.out' } })
			.from('.escenario__img', { autoAlpha: 0, scale: 1.03, duration: 1.2 }, 0)
			.fromTo('.titulo__somos span', { clipPath: 'inset(-20% 100% -20% 0)' }, { clipPath: 'inset(-20% -5% -20% 0)', duration: 0.9, ease: 'power1.inOut' }, 0.2)
			.fromTo('.titulo__loja span', { clipPath: 'inset(-20% 100% -20% 0)' }, { clipPath: 'inset(-20% -5% -20% 0)', duration: 0.7, ease: 'power1.inOut' }, 1)
			.from('.titulo__lema', { autoAlpha: 0, y: 16, duration: 0.6 }, 1.5)
			.from('.hero-ticket', { autoAlpha: 0, y: 16, duration: 0.6, stagger: 0.12 }, 1.65);
		gsap.to('.apertura__rama', { rotate: 3, duration: 3.2, ease: 'sine.inOut', yoyo: true, repeat: -1, transformOrigin: '0% 0%' });

		// A living cathedral, only where it costs little.
		const video = document.querySelector<HTMLVideoElement>('.escenario__video');
		const urlVideo = document.documentElement.dataset.video;
		if (video && urlVideo && !movil && !ahorro) {
			video.src = urlVideo;
			video.addEventListener('canplay', () => { video.classList.add('listo'); video.play().catch(() => {}); }, { once: true });
			video.load();
			new IntersectionObserver(([e]) => { if (e.isIntersecting) video.play().catch(() => {}); else video.pause(); }).observe(video);
		}

		// Scroll: the square gives way to one large bean.
		gsap.timeline({ defaults: { ease: 'none' }, scrollTrigger: { trigger: '.apertura', start: 'top top', end: 'bottom bottom', scrub: true } })
			.to('.titulo', { y: -90, autoAlpha: 0, duration: 0.18 }, 0.7)
			.to('.apertura__seguir', { autoAlpha: 0, duration: 0.15 }, 0)
			.to('.apertura__rama', { x: -120, y: -120, autoAlpha: 0, duration: 0.2 }, 0.7)
			.to('.escenario', { scale: 1.08, y: 80, duration: 0.7, transformOrigin: '50% 45%' }, 0.05)
			.to('.escenario', { autoAlpha: 0, duration: 0.2 }, 0.72)
			.fromTo('.apertura__grano', { yPercent: -180, rotate: -50, scale: 0.55 }, { yPercent: 0, rotate: 18, scale: 1, duration: 0.65 }, 0)
			.fromTo('.apertura__frase', { autoAlpha: 0, y: 40 }, { autoAlpha: 1, y: 0, duration: 0.2 }, 0.55)
			.to('.apertura__grano', { rotate: 40, duration: 0.3 }, 0.65);

		// The coffee ribbon draws itself through three alternating chapters.
		gsap.utils.toArray<SVGPathElement>('.cinta path').forEach((p) => {
			const largo = p.getTotalLength();
			gsap.fromTo(p, { strokeDasharray: largo, strokeDashoffset: largo }, { strokeDashoffset: 0, ease: 'none', scrollTrigger: { trigger: '.proceso', start: 'top 60%', end: 'bottom 70%', scrub: true } });
		});
		gsap.utils.toArray<HTMLElement>('.capitulo').forEach((c) => {
			const dibujo = c.querySelector('.capitulo__img');
			if (dibujo) gsap.from(dibujo, { autoAlpha: 0, scale: 0.94, y: 48, duration: 0.9, ease: 'power3.out', scrollTrigger: { trigger: c, start: 'top 72%' } });
			gsap.from(c.querySelector('.capitulo__texto'), { autoAlpha: 0, y: 32, duration: 0.8, delay: 0.1, ease: 'power3.out', scrollTrigger: { trigger: c, start: 'top 68%' } });
			// "Del dibujo a la foto": the real print develops from the paper while scrolling.
			const revelado = gsap.timeline({ scrollTrigger: { trigger: c, start: 'top 65%', end: 'center 50%', scrub: 0.6 } });
			c.querySelectorAll('.capitulo__foto').forEach((foto, k) => {
				revelado.fromTo(foto, { clipPath: 'inset(100% 0% 0% 0%)', y: 64, scale: 1.05 }, { clipPath: 'inset(0% 0% 0% 0%)', y: 0, scale: 1, ease: 'none', duration: 1 }, k * 0.4);
			});
			if (dibujo) revelado.to(dibujo, { opacity: 0.62, scale: 0.97, ease: 'none', duration: 1 }, 0);
			revelado.fromTo(c.querySelector('.capitulo__sello'), { autoAlpha: 0, scale: 1.8 }, { autoAlpha: 1, scale: 1, ease: 'back.out(2.2)', duration: 0.35 }, '>-0.1');
		});

		// Cascade: the bean falls and the cup fills.
		iniciarCascada(gsap, ScrollTrigger);

		// The 50: scroll drives real 3D beans.
		const etapa = document.querySelector<HTMLElement>('.cincuenta')!;
		const canvas = document.getElementById('granos') as HTMLCanvasElement | null;
		function progreso() {
			const r = etapa.getBoundingClientRect();
			return Math.min(1, Math.max(0, (innerHeight * 0.6 - r.top) / ((r.height - innerHeight) * 0.7 + innerHeight * 0.6)));
		}
		if (canvas && !ahorro) {
			const vigia = new IntersectionObserver(([e]) => {
				if (!e.isIntersecting) return;
				vigia.disconnect();
				const acuarela = new URLSearchParams(location.search).get('granos') === 'acuarela';
				import(acuarela ? '../scripts/granos-acuarela.js' : '../scripts/granos-vintage.js')
					.then((m) => m.iniciarGranos(canvas, document.querySelector('.cincuenta__fijo')!, progreso))
					.then(() => document.documentElement.classList.add('con-granos'))
					.catch(() => canvas.remove());
			}, { rootMargin: '120% 0px' });
			vigia.observe(etapa);
		}
		gsap.fromTo('.cincuenta__texto', { autoAlpha: 0, y: 32 }, { autoAlpha: 1, y: 0, ease: 'none', scrollTrigger: { trigger: etapa, start: () => 'top+=' + etapa.offsetHeight * 0.14 + ' top', end: () => 'top+=' + etapa.offsetHeight * 0.34 + ' top', scrub: true } });

		// Store.
		gsap.from('.tienda__texto > *', { autoAlpha: 0, y: 24, duration: 0.7, stagger: 0.06, ease: 'power3.out', scrollTrigger: { trigger: '.tienda', start: 'top 68%' } });
		gsap.from('.mapa, .foto', { autoAlpha: 0, y: 48, duration: 0.9, stagger: 0.1, ease: 'power3.out', scrollTrigger: { trigger: '.tienda__rejilla', start: 'top 70%' } });
		addEventListener('load', () => ScrollTrigger.refresh());
	}
</script>
