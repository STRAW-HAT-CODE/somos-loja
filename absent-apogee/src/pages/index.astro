---
import Layout from '../layouts/Layout.astro';
import Pendiente from '../components/Pendiente.astro';
import Flecha from '../components/Flecha.astro';
import { capitulos, categorias, cifras, enlaces, ilustraciones, interior, letrero, logo, pendiente, productos, sello } from '../data/somos-loja';
---
<Layout>
	<a class="saltar" href="#tienda">Saltar a la tienda</a>
	<header class="cabecera">
		<a class="cabecera__logo" href="#inicio" aria-label="Somos Loja, volver al inicio"><img src={logo} alt="" width="40" height="40" /></a>
		<a class="boton boton--tinta boton--chico" href="#tienda">Ver la tienda</a>
	</header>

	<main>
		<section id="inicio" class="apertura">
			<div class="apertura__fijo">
				<img class="apertura__rama" src={ilustraciones.rama} alt="" width="800" height="800" fetchpriority="high" />
				<div class="apertura__titulo">
					<p class="firma">Somos Loja</p>
					<h1 class="versal">Café y productos de Loja, en una sola tienda</h1>
				</div>
				<img class="apertura__ciudad" src={ilustraciones.portada} alt="Ilustración de un pueblo andino con casas coloniales y montañas azules" width="1672" height="941" fetchpriority="high" />
				<img class="apertura__grano" src={ilustraciones.grano} alt="" width="900" height="900" />
				<h2 class="titular apertura__frase">En Loja, cada grano<br />tiene una historia</h2>
			</div>
		</section>

		<section class="recorrido" aria-label="El camino del café">
			<svg class="cinta" viewBox="0 0 1000 2400" preserveAspectRatio="none" aria-hidden="true">
				<path class="cinta__ancha" d="M500 0C820 240 900 520 620 760S120 1040 240 1320 860 1560 780 1880 420 2240 500 2400" />
				<path class="cinta__fina" d="M520 0C860 240 930 540 640 780S150 1060 270 1330 890 1580 800 1890 450 2240 520 2400" />
			</svg>
			{capitulos.map((c, i) => (
				<article class={`capitulo capitulo--${i % 2 ? 'der' : 'izq'}`}>
					<img class="capitulo__img" src={c.img} alt={c.alt} width={c.ancho} height={c.alto} loading="lazy" decoding="async" />
					<div class="capitulo__texto">
						<h2 class="titular">{c.titulo}</h2>
						<p class="cuerpo">{c.texto}</p>
					</div>
				</article>
			))}
		</section>

		<section id="evento" class="cincuenta">
			<div class="cincuenta__fijo">
				<canvas id="granos" aria-hidden="true"></canvas>
				<p class="cincuenta__respaldo" aria-hidden="true">50</p>
				<div class="cincuenta__texto">
					<h2 class="titular">marcas y fincas de café</h2>
					<p class="cuerpo">En Loja 100 % Café Especial, un campeonato interno elige el top 10 de especialidad. Son 10 días de filtrados, V60 y concurso de chuspas.</p>
					<p class="cincuenta__evento"><img src={sello} alt="Sello Loja 100 % Café Especial" width="56" height="56" loading="lazy" /><span class="versal versal--chica">Tercera edición</span> {pendiente.fecha ?? <Pendiente dato="fecha" />}</p>
				</div>
			</div>
		</section>

		<section id="tienda" class="tienda">
			<div class="tienda__cabeza">
				<figure class="tienda__foto"><img src={interior} alt="Interior de la tienda Somos Loja con una vitrina llena de productos" width="1200" height="1600" loading="lazy" decoding="async" /></figure>
				<div class="tienda__texto">
					<p class="firma firma--clara">La tienda</p>
					<h2 class="titular">Todo esto te espera en un solo lugar</h2>
					<p class="cuerpo">Somos Loja es la cooperativa que reúne el trabajo de emprendedores y productores lojanos, para que te lleves un pedazo de Loja.</p>
					<ul class="cifras">
						{cifras.map(([n, d]) => <li><strong>{n}</strong><span>{d}</span></li>)}
					</ul>
					<ul class="categorias">{categorias.map((c) => <li>{c}</li>)}</ul>
					<a class="boton boton--ocre" href={enlaces.mapa} target="_blank" rel="noopener">Cómo llegar a la tienda<Flecha /></a>
				</div>
			</div>
			<ul class="productos">
				{productos.map((p, i) => (
					<li class="producto" style={`--r:${(i - 2.5) * 1.6}deg`}>
						<img src={p.src} alt={p.alt} width="800" height="1067" loading="lazy" decoding="async" />
						<h3>{p.titulo}</h3>
					</li>
				))}
			</ul>
		</section>

		<section id="visita" class="visita">
			<img class="visita__rama" src={ilustraciones.rama} alt="" width="800" height="800" loading="lazy" />
			<div class="visita__texto">
				<p class="firma firma--media">Te esperamos</p>
				<h2 class="titular">Ven por un café y llévate algo hecho aquí</h2>
				<p class="cuerpo">Loja, Ecuador {pendiente.direccion ?? <Pendiente dato="direccion" />} {pendiente.horario ?? <Pendiente dato="horario" />}</p>
				<div class="visita__acciones">
					<a class="boton boton--ocre" href={enlaces.mapa} target="_blank" rel="noopener">Visita la tienda<Flecha /></a>
					<a class="boton boton--linea" href={enlaces.instagram} target="_blank" rel="noopener">Instagram</a>
					{pendiente.facebook ?? <Pendiente dato="facebook" />}
					{pendiente.tiktok ?? <Pendiente dato="tiktok" />}
				</div>
			</div>
			<img class="visita__letrero" src={letrero} alt="Letrero de Somos Loja sobre los estantes de la tienda" width="1024" height="576" loading="lazy" decoding="async" />
		</section>
	</main>

	<footer class="pie">
		<img src={logo} alt="Somos Loja Tienda" width="56" height="56" loading="lazy" />
		<p>Somos Loja, Coopser. Productos de emprendedores y productores locales.</p>
		<Pendiente dato="enlaces legales" />
	</footer>
</Layout>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import Lenis from 'lenis';

	const reducir = matchMedia('(prefers-reduced-motion: reduce)').matches;
	gsap.registerPlugin(ScrollTrigger);

	if (!reducir) {
		document.documentElement.classList.add('animado');
		const lenis = new Lenis({ lerp: 0.085, wheelMultiplier: 0.85 });
		lenis.on('scroll', ScrollTrigger.update);
		gsap.ticker.add((s) => lenis.raf(s * 1000));
		gsap.ticker.lagSmoothing(0);
		document.querySelectorAll('a[href^="#"]').forEach((a) => a.addEventListener('click', (e) => {
			e.preventDefault();
			lenis.scrollTo(a.getAttribute('href')!, { duration: 1.6 });
		}));

		// Opening: the town gives way to one large bean, as if the camera looked closer.
		gsap.timeline({ defaults: { ease: 'none' }, scrollTrigger: { trigger: '.apertura', start: 'top top', end: 'bottom bottom', scrub: true } })
			.to('.apertura__titulo', { y: -120, autoAlpha: 0, duration: 0.3 }, 0)
			.to('.apertura__rama', { x: -120, y: -120, rotate: -8, duration: 0.5 }, 0)
			.to('.apertura__ciudad', { scale: 1.16, y: 220, autoAlpha: 0, duration: 0.55, transformOrigin: '50% 80%' }, 0.05)
			.fromTo('.apertura__grano', { yPercent: -180, rotate: -50, scale: 0.55 }, { yPercent: 0, rotate: 18, scale: 1, duration: 0.65 }, 0)
			.fromTo('.apertura__frase', { autoAlpha: 0, y: 40 }, { autoAlpha: 1, y: 0, duration: 0.2 }, 0.55)
			.to('.apertura__grano', { rotate: 40, duration: 0.3 }, 0.65);

		// A ribbon of coffee draws itself through the three chapters.
		gsap.utils.toArray<SVGPathElement>('.cinta path').forEach((p) => {
			const largo = p.getTotalLength();
			gsap.fromTo(p, { strokeDasharray: largo, strokeDashoffset: largo }, { strokeDashoffset: 0, ease: 'none', scrollTrigger: { trigger: '.recorrido', start: 'top 60%', end: 'bottom 70%', scrub: true } });
		});
		gsap.utils.toArray<HTMLElement>('.capitulo').forEach((c) => {
			gsap.from(c.querySelector('.capitulo__img'), { autoAlpha: 0, scale: 0.94, y: 48, duration: 0.9, ease: 'power3.out', scrollTrigger: { trigger: c, start: 'top 72%' } });
			gsap.from(c.querySelector('.capitulo__texto'), { autoAlpha: 0, y: 32, duration: 0.8, delay: 0.1, ease: 'power3.out', scrollTrigger: { trigger: c, start: 'top 68%' } });
		});

		// The 50: scroll drives the beans; text arrives when they have landed.
		const etapa = document.querySelector<HTMLElement>('.cincuenta')!;
		const canvas = document.getElementById('granos') as HTMLCanvasElement | null;
		function progreso() {
			const r = etapa.getBoundingClientRect();
			return Math.min(1, Math.max(0, (innerHeight * 0.5 - r.top) / ((r.height - innerHeight) * 0.75 + innerHeight * 0.5)));
		}
		const ahorro = (navigator as any).connection?.saveData;
		if (canvas && !ahorro) {
			const vigia = new IntersectionObserver(([e]) => {
				if (!e.isIntersecting) return;
				vigia.disconnect();
				import('../scripts/granos-vintage.js')
					.then((m) => m.iniciarGranos(canvas, document.querySelector('.cincuenta__fijo')!, progreso))
					.then(() => document.documentElement.classList.add('con-granos'))
					.catch(() => canvas.remove());
			}, { rootMargin: '150% 0px' });
			vigia.observe(etapa);
		}
		gsap.fromTo('.cincuenta__texto', { autoAlpha: 0, y: 40 }, { autoAlpha: 1, y: 0, ease: 'none', scrollTrigger: { trigger: etapa, start: () => 'top+=' + etapa.offsetHeight * 0.32 + ' top', end: () => 'top+=' + etapa.offsetHeight * 0.46 + ' top', scrub: true } });

		// Store: its elements arrive one after another; products fan out.
		gsap.from('.tienda__foto', { autoAlpha: 0, y: 60, duration: 1, ease: 'power3.out', scrollTrigger: { trigger: '.tienda', start: 'top 65%' } });
		gsap.from('.tienda__texto > *', { autoAlpha: 0, y: 28, duration: 0.7, stagger: 0.07, ease: 'power3.out', scrollTrigger: { trigger: '.tienda', start: 'top 60%' } });
		gsap.from('.producto', { autoAlpha: 0, y: 120, rotate: 0, duration: 0.9, stagger: 0.08, ease: 'power3.out', scrollTrigger: { trigger: '.productos', start: 'top 85%' } });
		gsap.from('.visita__letrero', { autoAlpha: 0, y: 48, duration: 0.9, ease: 'power3.out', scrollTrigger: { trigger: '.visita', start: 'top 70%' } });
		addEventListener('load', () => ScrollTrigger.refresh());
	}
</script>
