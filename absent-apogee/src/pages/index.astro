---
import Layout from '../layouts/Layout.astro';
import Pendiente from '../components/Pendiente.astro';
import Flecha from '../components/Flecha.astro';
import { cifras, enlaces, evento, final, fondo, logo, momentos, otrasCategorias, pendiente, tarjetas } from '../data/somos-loja';
---
<Layout>
	<a class="saltar button-sm" href="#tienda">Saltar a la tienda</a>
	<header class="cabecera">
		<a class="cabecera__logo" href="#inicio" aria-label="Somos Loja, volver al inicio"><img src={logo} alt="" width="36" height="36" /></a>
		<a class="boton boton--primario button-sm" href={enlaces.mapa} target="_blank" rel="noopener">Cómo llegar</a>
	</header>

	<main>
		<section id="inicio" class="portada">
			<video class="portada__video" autoplay muted loop playsinline preload="metadata" poster={fondo.poster} aria-hidden="true" tabindex="-1">
				<source src={fondo.video} type="video/mp4" />
			</video>
			<div class="velo"></div>
			<canvas id="granos" aria-hidden="true"></canvas>
			<div class="portada__contenido">
				<div class="portada__texto">
					<h1 class="display">Todo lo que Loja produce, en una sola tienda.</h1>
					<p class="body-grande">Somos Loja es la cooperativa que reúne el café, las artesanías y los productos de emprendedores lojanos.</p>
					<div class="portada__acciones">
						<a class="boton boton--primario button-md" href={enlaces.mapa} target="_blank" rel="noopener">Visita la tienda<Flecha /></a>
						<p class="caption-1 portada__lugar">Loja, Ecuador {pendiente.direccion ?? <Pendiente dato="direccion" />} {pendiente.horario ?? <Pendiente dato="horario" />}</p>
					</div>
				</div>
				<aside class="evento">
					<img src={evento.sello} alt={`Sello ${evento.nombre}`} width="96" height="96" />
					<div>
						<h2 class="heading-5">{evento.nombre}</h2>
						<p class="caption-2">{evento.edicion}. {evento.detalle}</p>
					</div>
				</aside>
				<ul class="cifras">
					{cifras.map(([n, d]) => <li><strong class="heading-3">{n}</strong><span class="caption-2">{d}</span></li>)}
				</ul>
			</div>
		</section>

		<section class="escena" aria-label="Del café a la tienda">
			<div class="escena__fijo">
				<canvas id="proceso" aria-hidden="true"></canvas>
				<img class="escena__respaldo" src={final} alt="" width="1024" height="576" loading="lazy" />
				<div class="velo velo--escena"></div>
				<div class="momentos">
					{momentos.map((m) => (
						<div class="momento">
							<p class="display momento__palabra">{m.palabra}</p>
							<figure class="ficha">
								<img src={m.foto} alt={m.alt} width="720" height="960" loading="lazy" decoding="async" />
								<figcaption class="body-3">{m.dato}</figcaption>
							</figure>
						</div>
					))}
				</div>
				<ol class="avance" aria-label="Etapas del café">
					{momentos.map((m) => <li class="caption-1"><i></i>{m.etapa}</li>)}
				</ol>
				<div id="tienda" class="tienda">
					<div class="tienda__titulo">
						<h2 class="display">Llévate Loja contigo</h2>
						<ul class="fichas">{otrasCategorias.map((c) => <li class="caption-1">También {c.toLowerCase()}</li>)}</ul>
					</div>
					<ul class="tarjetas">
						{tarjetas.map((t, i) => (
							<li class="tarjeta" style={`--i:${i}`}>
								<img src={t.src} alt={t.alt} width="800" height="1067" loading="lazy" decoding="async" />
								<h3 class="caption-1">{t.titulo}</h3>
							</li>
						))}
					</ul>
					<div class="acciones">
						<a class="boton boton--primario button-md" href={enlaces.mapa} target="_blank" rel="noopener">Visita la tienda<Flecha /></a>
						<a class="boton boton--secundario button-md" href={enlaces.instagram} target="_blank" rel="noopener">Instagram</a>
						{pendiente.facebook ?? <Pendiente dato="facebook" />}
						{pendiente.tiktok ?? <Pendiente dato="tiktok" />}
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import Lenis from 'lenis';
	import { cuadros } from '../data/somos-loja';

	const reducir = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const ahorro = (navigator as any).connection?.saveData;
	const movil = innerWidth <= 860;
	gsap.registerPlugin(ScrollTrigger);

	const portada = document.querySelector<HTMLElement>('.portada');
	const canvasGranos = document.getElementById('granos') as HTMLCanvasElement | null;
	if (reducir) document.querySelector<HTMLVideoElement>('.portada__video')?.pause();

	if (!reducir) {
		const lenis = new Lenis({ lerp: 0.085, wheelMultiplier: 0.8 });
		lenis.on('scroll', ScrollTrigger.update);
		gsap.ticker.add((s) => lenis.raf(s * 1000));
		gsap.ticker.lagSmoothing(0);

		if (portada && canvasGranos && !ahorro) {
			const arrancar = () => import('../scripts/granos-cincuenta.js').then((m) => m.iniciarGranos(canvasGranos, portada)).catch(() => canvasGranos.remove());
			'requestIdleCallback' in window ? requestIdleCallback(arrancar, { timeout: 1200 }) : setTimeout(arrancar, 300);
		}

		// Process sequence: loads ends first, then fills in, and always draws the nearest ready frame.
		const canvas = document.getElementById('proceso') as HTMLCanvasElement;
		const ctx = canvas.getContext('2d', { alpha: false })!;
		const rutas = cuadros(movil);
		const imgs: HTMLImageElement[] = new Array(rutas.length);
		let dibujado = -1, pedido = 0;
		// Blends the two nearest frames so slow scrolling never shows a step between them.
		function dibujar() {
			const a = Math.floor(pedido), mezcla = pedido - a;
			let f = a, d = 0;
			while (!imgs[f] && d < rutas.length) { d++; f = imgs[a - d] ? a - d : a + d; }
			if (!imgs[f]) return;
			const clave = f + Math.round(mezcla * 8) / 8;
			if (clave === dibujado) return;
			ctx.globalAlpha = 1;
			ctx.drawImage(imgs[f], 0, 0);
			if (f === a && imgs[a + 1] && mezcla > 0.05) { ctx.globalAlpha = mezcla; ctx.drawImage(imgs[a + 1], 0, 0); }
			dibujado = clave;
		}
		function cargar() {
			const orden: number[] = [0, rutas.length - 1];
			for (let paso = 32; paso >= 1; paso = paso >> 1) for (let i = paso; i < rutas.length - 1; i += paso) if (!orden.includes(i)) orden.push(i);
			let sig = 0;
			const obrero = async () => {
				while (sig < orden.length) {
					const i = orden[sig++];
					const img = new Image();
					img.src = rutas[i];
					try { await img.decode(); } catch { continue; }
					if (!canvas.width || canvas.width === 300) { canvas.width = img.naturalWidth; canvas.height = img.naturalHeight; }
					imgs[i] = img;
					dibujado = -1;
					dibujar();
				}
			};
			for (let k = 0; k < 6; k++) obrero();
		}
		const vigia = new IntersectionObserver(([e]) => { if (e.isIntersecting) { vigia.disconnect(); cargar(); } }, { rootMargin: '100% 0px' });
		vigia.observe(canvas);

		// One timeline drives the whole second part: process first, then the store and its cards.
		const estado = { i: 0 };
		const momentos = gsap.utils.toArray<HTMLElement>('.momento');
		const tl = gsap.timeline({
			defaults: { ease: 'none' },
			scrollTrigger: { trigger: '.escena', start: 'top top', end: 'bottom bottom', scrub: true },
		});
		tl.to(estado, { i: rutas.length - 1, duration: 6, onUpdate: () => { pedido = estado.i; dibujar(); } }, 0);
		const barras = gsap.utils.toArray<HTMLElement>('.avance i');
		// Each stretch lasts 6/9 of the timeline: words follow what the footage is showing.
		const tiempos = [[0, 0.7], [0.7, 2], [2.7, 2], [4.7, 1.3]];
		momentos.forEach((m, n) => {
			const [ini, dur] = tiempos[n];
			if (n === 0) tl.set(m, { autoAlpha: 1, y: 0 }, 0);
			else tl.fromTo(m, { autoAlpha: 0, y: 32 }, { autoAlpha: 1, y: 0, duration: 0.25, ease: 'power2.out' }, ini);
			tl.to(m, { autoAlpha: 0, y: -32, duration: 0.2 }, ini + dur - 0.2);
			tl.fromTo(barras[n], { scaleX: 0 }, { scaleX: 1, duration: dur }, ini);
		});
		tl.to('.avance', { autoAlpha: 0, duration: 0.3 }, 5.8);
		tl.to('.velo--escena', { opacity: 1, duration: 0.8 }, 5.7);
		tl.fromTo('.tienda__titulo', { autoAlpha: 0, y: 40 }, { autoAlpha: 1, y: 0, duration: 0.6, ease: 'power2.out' }, 6);
		tl.fromTo('.tarjeta', { autoAlpha: 0, y: 180, rotate: (i) => (i - 2) * 9 }, { autoAlpha: 1, y: 0, rotate: (i) => (i - 2) * (movil ? 0 : 2.5), duration: 0.9, stagger: 0.14, ease: 'power3.out' }, 6.2);
		tl.fromTo('.acciones', { autoAlpha: 0, y: 24 }, { autoAlpha: 1, y: 0, duration: 0.5 }, 7.2);
		tl.to({}, { duration: 0.5 });

		document.querySelectorAll('a[href^="#"]').forEach((a) => a.addEventListener('click', (e) => {
			const id = a.getAttribute('href')!;
			e.preventDefault();
			lenis.scrollTo(id === '#tienda' ? document.documentElement.scrollHeight : 0, { duration: 1.2 });
		}));
	}
</script>
