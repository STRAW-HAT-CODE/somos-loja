---
---
<canvas id="grano" aria-hidden="true"></canvas>
<div id="proceso" class="ancla"></div>
<div id="world"></div>

<script>
  import { mountScrollWorld } from '../scripts/scroll-world.js';
  import { paradas, tramos } from '../data/somos-loja';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import Lenis from 'lenis';

  const PARADA = 0.6, TRAMO = 0.9;
  const world = document.getElementById('world');
  const reducir = matchMedia('(prefers-reduced-motion: reduce)').matches;
  gsap.registerPlugin(ScrollTrigger);

  if (world) {
    mountScrollWorld(world, {
      nav: false, atmosphere: false, staticStills: true,
      hint: 'Baja para recorrer',
      diveScroll: PARADA, connScroll: TRAMO, crossfade: 0.07,
      sections: paradas, connectors: tramos,
    });
  }

  if (!reducir) {
    const lenis = new Lenis({ lerp: 0.28 });
    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add((s) => lenis.raf(s * 1000));
    gsap.ticker.lagSmoothing(0);
    document.querySelectorAll('a[href^="#"]').forEach((a) => a.addEventListener('click', (e) => {
      const id = a.getAttribute('href');
      const destino = id && id.length > 1 ? document.querySelector(id) : 0;
      if (destino === null) return;
      e.preventDefault();
      lenis.scrollTo(destino, { duration: 1.6 });
    }));
  }

  // Beans start falling when the tagline comes in and finish while the 50 is held on screen.
  const lema = document.querySelector<HTMLElement>('.lema');
  const etapa = document.querySelector<HTMLElement>('.cincuenta');
  const fijo = document.querySelector<HTMLElement>('.cincuenta__fijo');
  function escena() {
    if (!lema || !etapa || !fijo) return { progreso: 0, tope: innerHeight * 2 };
    const inicio = lema.getBoundingClientRect().top - innerHeight * 0.55;
    const finE = etapa.getBoundingClientRect();
    const fin = finE.top + (finE.height - innerHeight) * 0.55;
    const total = fin - inicio;
    return { progreso: Math.min(1, Math.max(0, -inicio / total)), tope: fijo.getBoundingClientRect().top };
  }

  const ahorro = (navigator as any).connection?.saveData;
  const canvas = document.getElementById('grano') as HTMLCanvasElement | null;
  if (canvas && lema && !reducir && !ahorro) {
    // The 3D only downloads shortly before it is needed.
    const vigia = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      vigia.disconnect();
      import('../scripts/grano.js')
        .then((m) => m.iniciarGrano({ canvas, escena }))
        .then(() => document.documentElement.classList.add('con-grano'))
        .catch(() => canvas.remove());
    }, { rootMargin: '200% 0px' });
    vigia.observe(lema);
  }

  // Stamps walk sideways while the section is held, on large screens only.
  const riel = document.querySelector<HTMLElement>('.galeria__riel');
  if (riel && !reducir && innerWidth > 860) {
    gsap.to(riel, {
      x: () => -(riel.scrollWidth - innerWidth + 96),
      ease: 'none',
      scrollTrigger: { trigger: '.galeria', pin: true, scrub: true, start: 'top top', end: () => '+=' + riel.scrollWidth, invalidateOnRefresh: true },
    });
  }
  // Past the film its fixed layers stop painting.
  ScrollTrigger.create({ trigger: '.cincuenta', start: 'top top', end: 'max', toggleClass: { targets: 'html', className: 'fin-pelicula' } });

  // Sections reveal once as they enter.
  const revelar = new IntersectionObserver((entradas, obs) => {
    for (const e of entradas) if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); }
  }, { rootMargin: '0px 0px -12% 0px' });
  document.querySelectorAll('.revelar').forEach((n) => revelar.observe(n));

  addEventListener('load', () => ScrollTrigger.refresh());
</script>
