---
import Pendiente from './Pendiente.astro';
import Flecha from './Flecha.astro';
import { categorias, enlaces, evento, galeria, historia, logo, paradas, pendiente } from '../data/somos-loja';
const lema = [['Detrás', 'de', 'cada', 'taza'], ['hay', 'manos', 'lojanas.']];
const tienda = paradas[9].still;
const interior = galeria[0];
const fotos = galeria.slice(1);
---
<main id="contenido" class="contenido">
  <section class="lema" aria-label="Lema">
    <p class="heading-1 lema__texto">
      {lema.map((linea) => (
        <span class="lema__linea">{linea.map((p) => <span class="lema__palabra">{p} </span>)}</span>
      ))}
    </p>
  </section>

  <section id="evento" class="cincuenta">
    <div class="cincuenta__fijo">
      <div class="cincuenta__texto">
        <img class="cincuenta__sello" src={evento.sello} alt={`Sello ${evento.nombre}`} width="112" height="112" loading="lazy" />
        <h2 class="heading-1">{evento.nombre}</h2>
        <p class="body-grande">{evento.edicion}. Unas 50 marcas y fincas de Loja, en un solo evento, durante 10 días.</p>
        <p class="body-3">{pendiente.fecha ?? <Pendiente dato="fecha" />}</p>
      </div>
      <p class="cincuenta__respaldo" aria-hidden="true">50</p>
    </div>
  </section>

  <div class="solido">
  <section class="bloque campeonato">
    <div class="campeonato__cabeza revelar">
      <h2 class="heading-1">Solo 10 llegan a lo más alto</h2>
      <p class="body-grande">No todos los cafés son de especialidad. Por eso hacemos un campeonato interno: de 20 a 30 muestras sale un top 10 de especialidad.</p>
    </div>
    <ol class="etapas">
      {evento.etapas.map(([t, d], i) => (
        <li class="etapa revelar" style={`--i:${i}`}>
          <span class="etapa__n heading-5">{i + 1}</span>
          <h3 class="heading-3">{t}</h3>
          <p class="body-3">{d}</p>
        </li>
      ))}
    </ol>
    <div class="actividades revelar">
      <h3 class="heading-5">Una actividad distinta cada día</h3>
      <ul class="fichas">{evento.actividades.map((a) => <li class="caption-1">{a}</li>)}</ul>
      <Pendiente dato="programación completa" />
    </div>
  </section>

  <section id="historia" class="bloque historia">
    <figure class="marco historia__foto revelar">
      <img src={interior.src} alt={interior.alt} width="1200" height="1600" loading="lazy" decoding="async" />
    </figure>
    <div class="historia__texto revelar">
      <blockquote class="heading-1">{historia.cita}</blockquote>
      {historia.parrafos.map((p) => <p class="body-grande">{p}</p>)}
    </div>
    <ul class="cifras">
      {historia.cifras.map(([n, d], i) => (
        <li class="revelar" style={`--i:${i}`}><strong class="cifra">{n}</strong><span class="body-3">{d}</span></li>
      ))}
    </ul>
  </section>
  </div>

  <section id="tienda" class="galeria" aria-labelledby="titulo-tienda">
    <div class="galeria__riel">
      <div class="galeria__intro">
        <h2 id="titulo-tienda" class="heading-1">Un solo lugar para llevarte Loja</h2>
        <ul class="catalogo">
          {categorias.map(([c, d]) => <li><h3 class="title-1">{c}</h3><p class="body-6">{d}</p></li>)}
        </ul>
      </div>
      <ul class="galeria__lista">
        {fotos.map((f) => (
          <li class="foto">
            <div class="marco"><img src={f.src} alt={f.alt} width="800" height="1067" loading="lazy" decoding="async" /></div>
            {f.pie ? <p class="caption-1">{f.pie}</p> : <Pendiente dato="marca" />}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <div class="visita-fondo"><section id="visita" class="visita">
    <div class="marco revelar"><img src={tienda} alt="Letrero de Somos Loja sobre los estantes de la tienda" width="1280" height="720" loading="lazy" decoding="async" /></div>
    <div class="visita__texto revelar">
      <h2 class="heading-1">Te esperamos en Loja</h2>
      <p class="body-grande">Ven por un café y llévate algo hecho aquí.</p>
      <p class="body-3">{pendiente.direccion ?? <Pendiente dato="direccion" />}</p>
      <p class="body-3">{pendiente.horario ?? <Pendiente dato="horario" />}</p>
      <div class="visita__acciones">
        <a class="boton boton--primario button-md" href={enlaces.mapa} target="_blank" rel="noopener">Cómo llegar a la tienda<Flecha /></a>
        <a class="boton boton--secundario button-md" href={enlaces.instagram} target="_blank" rel="noopener">Síguenos en Instagram</a>
      </div>
      <p class="caption-2">{pendiente.facebook ?? <Pendiente dato="facebook" />} {pendiente.tiktok ?? <Pendiente dato="tiktok" />}</p>
    </div>
  </section></div>
</main>

<footer class="pie">
  <img src={logo} alt="Somos Loja Tienda" width="64" height="80" loading="lazy" />
  <p class="caption-2">Somos Loja, Coopser. Productos de emprendedores y productores locales.</p>
  <Pendiente dato="enlaces legales" />
</footer>

<script>
  const reducir = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const palabras = document.querySelectorAll('.lema__palabra');
  if (reducir) palabras.forEach((p) => p.classList.add('activa'));
  else {
    const obs = new IntersectionObserver((entradas) => {
      for (const e of entradas) if (e.isIntersecting) e.target.classList.add('activa');
    }, { rootMargin: '0px 0px -40% 0px' });
    palabras.forEach((p) => obs.observe(p));
  }
</script>
