---
// Partner brand logos floating on the paper, right after the coffee lands in the cup.
// Two CSS marquee rows drift in opposite directions; each logo bobs gently on its own
// beat. Every list renders twice and the track shifts by -50%, so the loop is seamless.
// Under prefers-reduced-motion the rows stop and wrap into a still grid.
import { marcas } from '../data/somos-loja';

const mitad = Math.ceil(marcas.length / 2);
const filas = [marcas.slice(0, mitad), marcas.slice(mitad)].filter((f) => f.length);
---

{marcas.length > 0 && (
	<section class="marcas" aria-labelledby="marcas-titulo">
		<h2 id="marcas-titulo" class="marcas__titulo">Marcas que encuentras en Somos Loja</h2>
		{filas.map((fila, f) => (
			<div class:list={['marcas__fila', { 'marcas__fila--inversa': f % 2 === 1 }]}>
				<ul class="marcas__pista" style={`--duracion: ${Math.max(28, fila.length * 5)}s`}>
					{[...fila, ...fila].map((m, i) => (
						<li class="marcas__item" aria-hidden={i >= fila.length ? 'true' : undefined} style={`--retraso: ${-((i * 0.9) % 5).toFixed(2)}s`}>
							<img src={m.src} alt={i >= fila.length ? '' : m.nombre} height="160" loading="eager" decoding="async" draggable="false" />
						</li>
					))}
				</ul>
			</div>
		))}
	</section>
)}

<style>
	.marcas {
		padding: clamp(56px, 9vw, 112px) 0 clamp(64px, 10vw, 128px);
		background: var(--papel);
		overflow: hidden;
	}

	.marcas__titulo {
		margin: 0 auto clamp(28px, 4vw, 48px);
		padding: 0 16px;
		max-width: 22ch;
		text-align: center;
		font-family: 'Cormorant', Georgia, serif;
		font-size: clamp(1.9rem, 4.2vw, 3rem);
		line-height: 1.05;
		font-weight: 600;
		letter-spacing: -0.01em;
		text-wrap: balance;
		color: var(--tinta);
	}

	.marcas__fila {
		/* Logos fade in and out at the edges instead of being cut by the viewport. */
		mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
	}

	.marcas__fila + .marcas__fila {
		margin-top: clamp(8px, 2vw, 20px);
	}

	.marcas__pista {
		display: flex;
		align-items: center;
		width: max-content;
		margin: 0;
		padding: 14px 0;
		list-style: none;
		animation: marcas-correr var(--duracion, 40s) linear infinite;
	}

	.marcas__fila--inversa .marcas__pista {
		animation-direction: reverse;
	}

	.marcas:hover .marcas__pista {
		animation-play-state: paused;
	}

	.marcas__item {
		flex: none;
		/* Trailing margin, not flex gap, so -50% lands exactly on the second copy. */
		margin-right: clamp(36px, 6vw, 72px);
		animation: marcas-flotar 5s ease-in-out var(--retraso, 0s) infinite;
	}

	.marcas__item img {
		display: block;
		height: clamp(60px, 8vw, 84px);
		width: auto;
		max-width: clamp(150px, 22vw, 220px);
		object-fit: contain;
		user-select: none;
		filter: drop-shadow(0 6px 8px rgb(90 51 28 / 0.16));
		transition: transform 300ms var(--curva), filter 300ms var(--curva);
	}

	.marcas__item img:hover {
		transform: scale(1.08);
		filter: drop-shadow(0 12px 14px rgb(90 51 28 / 0.22));
	}

	@keyframes marcas-correr {
		to { transform: translateX(-50%); }
	}

	@keyframes marcas-flotar {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-8px); }
	}

	@media (prefers-reduced-motion: reduce) {
		.marcas__fila { mask-image: none; }
		.marcas__pista {
			animation: none;
			flex-wrap: wrap;
			justify-content: center;
			width: auto;
			padding: 0 16px;
			gap: 24px 0;
		}
		.marcas__item { animation: none; }
		.marcas__item[aria-hidden='true'] { display: none; }
	}
</style>
