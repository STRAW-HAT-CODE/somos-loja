---
// Social links as icon buttons on a transparent background. A network without a
// confirmed link is not rendered, so no dead icon reaches visitors.
import { enlaces, pendiente } from '../data/somos-loja';

const redes = [
	{ nombre: 'Instagram', href: enlaces.instagram, icono: 'instagram' },
	{ nombre: 'Facebook', href: pendiente.facebook, icono: 'facebook' },
	{ nombre: 'TikTok', href: pendiente.tiktok, icono: 'tiktok' },
].filter((red) => red.href);
---

<ul class="redes" aria-label="Redes sociales de Somos Loja">
	{redes.map((red) => (
		<li>
			<a class="redes__enlace" href={red.href} target="_blank" rel="noopener" aria-label={`${red.nombre} de Somos Loja`} title={red.nombre}>
				{red.icono === 'instagram' && (
					<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
						<rect x="3" y="3" width="18" height="18" rx="5" />
						<circle cx="12" cy="12" r="4.2" />
						<circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none" />
					</svg>
				)}
				{red.icono === 'facebook' && (
					<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
						<path d="M9.1 23.7v-8H6.6V12h2.5v-1.6c0-4.1 1.8-6 5.9-6 .8 0 2.1.2 2.6.3v3.3c-.3 0-.8-.1-1.4-.1-2 0-2.8.8-2.8 2.7V12h3.9l-.7 3.7h-3.2V24c5.9-.7 10.5-5.8 10.5-12C24 5.4 18.6 0 12 0S0 5.4 0 12c0 5.6 3.9 10.4 9.1 11.7Z" />
					</svg>
				)}
				{red.icono === 'tiktok' && (
					<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
						<path d="M12.53.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03a10.7 10.7 0 0 1-5.82-1.9c-.01 2.92.01 5.84-.02 8.75a7.6 7.6 0 0 1-1.35 3.94 7.4 7.4 0 0 1-5.91 3.21 7.3 7.3 0 0 1-7.73-6.74c-.02-.5-.03-1-.01-1.49a7.4 7.4 0 0 1 8.73-6.68c.02 1.48-.04 2.96-.04 4.44a3.4 3.4 0 0 0-4.38 2.12c-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87a3.3 3.3 0 0 0 3.18-2.67c.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07Z" />
					</svg>
				)}
			</a>
		</li>
	))}
</ul>

<style>
	.redes {
		display: flex;
		gap: 10px;
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.redes__enlace {
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		border-radius: 50%;
		background: transparent;
		border: 1px solid color-mix(in srgb, currentColor 35%, transparent);
		color: inherit;
		transition: background-color 200ms var(--curva), border-color 200ms var(--curva), transform 200ms var(--curva);
	}

	.redes__enlace svg {
		width: 22px;
		height: 22px;
	}

	.redes__enlace:hover {
		background: color-mix(in srgb, currentColor 12%, transparent);
		border-color: currentColor;
		transform: translateY(-2px);
	}

	.redes__enlace:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 3px;
	}
</style>
