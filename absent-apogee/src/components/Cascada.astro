---
// Partner logos are born from the bean: they burst out of it and settle floating between the headline and the cup.
import { marcas } from '../data/somos-loja';
---

<section id="taza" class="cascada" aria-label="Un grano de café cae y se junta en una taza">
	<div class="cascada__escena">
		<div class="cascada__granitos" aria-hidden="true"></div>
		<div class="cascada__polvo" aria-hidden="true"><img src="/cascada/polvo.webp" alt="" width="1254" height="1254" loading="lazy" decoding="async" /></div>

		<div class="cascada__taza-wrap">
			<div class="cascada__taza">
				<img class="cascada__taza-img" src="/cascada/taza.webp" alt="Taza andina de café" width="1536" height="1024" loading="lazy" decoding="async" />
				<img class="cascada__taza-fase cascada__taza-granos" src="/cascada/taza-con-granos-v1.webp" alt="" width="768" height="512" loading="lazy" decoding="async" />
				<img class="cascada__taza-fase cascada__taza-cafe" src="/cascada/taza-cafe-servido-v1.webp" alt="" width="768" height="512" loading="lazy" decoding="async" />
			</div>
		</div>

		<div class="cascada__grano-grande" aria-hidden="true"><img src="/cascada/grano.webp" srcset="/cascada/grano-600.webp 600w, /cascada/grano.webp 1254w" sizes="40vh" alt="" width="1254" height="1254" loading="lazy" decoding="async" /></div>

		<ul class="cascada__marcas" aria-label="Marcas que encuentras en Somos Loja">
			{marcas.map((m) => (
				<li class="cascada__marca"><img src={m.src} alt={m.nombre} height="160" loading="eager" decoding="async" draggable="false" /></li>
			))}
		</ul>

		<div class="cascada__texto">
			<h2 class="titular titular--media">El grano llega a la taza</h2>
			<p class="cuerpo">Catas, filtrados y encuentros con las marcas de Loja.</p>
			<a class="cascada__cta" href="#evento">Ven a probarlo del 13 al 22 de noviembre <span aria-hidden="true">→</span></a>
		</div>
	</div>
</section>

<style is:global>
	.cascada {
		position: relative;
		background: var(--papel);
	}

	.cascada__escena {
		position: relative;
		height: 100svh;
		overflow: hidden;
		background: var(--papel);
	}

	.cascada__grano-grande {
		position: absolute;
		left: 50%;
		top: 27%;
		z-index: 6;
		width: min(38vh, 54vw);
		margin: calc(min(38vh, 54vw) / -2) 0 0 calc(min(38vh, 54vw) / -2);
		will-change: transform, opacity;
		display: none;
	}

	.cascada__granitos {
		position: absolute;
		inset: 0;
		z-index: 2;
		pointer-events: none;
	}

	.cascada__granito {
		position: absolute;
		left: 50%;
		top: 27%;
		width: calc(clamp(28px, 6vh, 70px) * var(--k, 1));
		aspect-ratio: 1;
		margin-left: calc(clamp(28px, 6vh, 70px) * var(--k, 1) / -2);
		margin-top: calc(clamp(28px, 6vh, 70px) * var(--k, 1) / -2);
		background: url('/cascada/grano.webp') center / contain no-repeat;
		opacity: 0;
		will-change: transform, opacity;
	}

	.cascada__polvo {
		position: absolute;
		left: 50%;
		top: 27%;
		z-index: 7;
		width: min(46vh, 62vw);
		margin: calc(min(46vh, 62vw) / -2) 0 0 calc(min(46vh, 62vw) / -2);
		opacity: 0;
		pointer-events: none;
	}

	.cascada__taza-wrap {
		position: absolute;
		left: 50%;
		bottom: 9vh;
		z-index: 3;
		width: min(50vh, 60vw);
		margin-left: calc(min(50vh, 60vw) / -2);
	}

	.cascada__taza {
		position: relative;
		width: 100%;
	}

	.cascada__taza-img {
		width: 100%;
		filter: drop-shadow(0 22px 26px rgb(24 82 105 / 0.18));
	}

	.cascada__taza-fase {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: contain;
		opacity: 0;
		will-change: opacity;
	}

	/* Static mode (reduced motion / no JS): logos rest in a band between headline and cup. */
	.cascada__marcas {
		position: absolute;
		left: 50%;
		top: calc(28vh + 140px);
		z-index: 5;
		width: min(92vw, 1100px);
		translate: -50% 0;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 10px 26px;
		margin: 0;
		padding: 0;
		list-style: none;
		pointer-events: none;
	}

	/* Every logo sits in the same cell so mixed badges and wordmarks line up on one grid. */
	.cascada__marca {
		--celda-w: clamp(96px, 7.6vw, 150px);
		--celda-h: calc(var(--celda-w) * 0.5);
		display: block;
		width: var(--celda-w);
		height: var(--celda-h);
	}

	.cascada__marca img {
		display: block;
		width: var(--celda-w);
		height: var(--celda-h);
		object-fit: contain;
		filter: drop-shadow(0 5px 7px rgb(90 51 28 / 0.18));
		animation: marca-flotar 4.6s ease-in-out var(--retraso, 0s) infinite;
	}

	@keyframes marca-flotar {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-4px); }
	}

	/* Animated mode: the script places every logo; they start hidden inside the bean. */
	.cascada--animada .cascada__marcas {
		inset: 0;
		top: 0;
		left: 0;
		width: auto;
		translate: none;
		display: block;
	}

	.cascada--animada .cascada__marca {
		position: absolute;
		left: 0;
		top: 0;
		opacity: 0;
		will-change: transform, opacity;
	}

	@media (prefers-reduced-motion: reduce) {
		.cascada__marca img { animation: none; }
	}

	.cascada__cta { justify-self: center; display: inline-flex; align-items: center; gap: 6px; min-height: 44px; margin-top: 4px; color: var(--tinta); font-weight: 600; text-decoration: underline; text-decoration-color: var(--durazno); text-decoration-thickness: 2px; text-underline-offset: 5px; pointer-events: auto; }

	.cascada__texto {
		position: absolute;
		left: 50%;
		top: 28vh;
		z-index: 8;
		width: min(92vw, 620px);
		translate: -50% 0;
		display: grid;
		gap: 10px;
		text-align: center;
	}

	.cascada__texto .cuerpo {
		max-width: 44ch;
		margin: 0 auto;
		color: var(--tinta-suave);
	}

	/* Animated mode: the scene is pinned and its pieces start hidden. */
	.cascada--animada {
		height: 300vh;
	}

	.cascada--animada .cascada__escena {
		position: sticky;
		top: 0;
	}

	.cascada--animada .cascada__grano-grande {
		display: block;
	}

	.cascada--animada .cascada__texto {
		opacity: 0;
	}

	@media (max-width: 760px) {
		.cascada__marca { --celda-w: 60px; --celda-h: 34px; }

		/* The scene plays by time on touch screens, so a shorter pin is enough. */
		.cascada--animada {
			height: 165vh;
		}

		.cascada__escena {
			height: 100svh;
		}

		/* Headline higher and cup lower open a calm band for the logo grid. */
		.cascada__texto {
			top: 15svh;
		}

		.cascada__taza-wrap {
			bottom: 7svh;
			width: min(40vh, 72vw);
			margin-left: calc(min(40vh, 72vw) / -2);
		}

		.cascada__grano-grande {
			width: min(34vh, 62vw);
			margin: calc(min(34vh, 62vw) / -2) 0 0 calc(min(34vh, 62vw) / -2);
		}
	}
</style>
