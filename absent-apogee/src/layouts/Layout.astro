---
import '../styles/global.css';
const titulo = 'Somos Loja | El sabor de nuestra tierra, el arte de nuestra gente';
const descripcion = 'Café, barro negro, chocolates, licores y artesanías de emprendedores lojanos, en una tienda a pasos de la Catedral de Loja.';
const imagen = '/carpeta-a-usar-web/vintage/fachada.webp';
---
<!doctype html>
<html lang="es" data-video="/carpeta-a-usar-web/vintage/catedral.mp4">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" type="image/webp" href="/carpeta-a-usar-web/sello-circular-64.webp" />
		<link rel="preload" href="/fonts/cormorant-latin-var.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/yellowtail-latin.woff2" as="font" type="font/woff2" crossorigin />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#f6eedd" />
		<title>{titulo}</title>
		<meta name="description" content={descripcion} />
		<meta property="og:title" content={titulo} />
		<meta property="og:description" content={descripcion} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_EC" />
		<meta property="og:image" content={imagen} />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<slot />
	</body>
</html>
