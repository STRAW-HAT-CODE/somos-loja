---
import '../styles/global.css';
const titulo = 'Somos Loja | Café y productos de Loja, en una sola tienda';
const descripcion = 'Somos Loja reúne café, artesanías y productos de emprendedores lojanos. Conoce la tienda y Loja 100 % Café Especial.';
const imagen = '/carpeta-a-usar-web/vintage/portada.webp';
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" type="image/webp" href="/carpeta-a-usar-web/sello-circular.webp" />
		<link rel="preload" href="/fonts/cormorant-latin-var.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/yellowtail-latin.woff2" as="font" type="font/woff2" crossorigin />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#f6eedd" />
		<title>{titulo}</title>
		<meta name="description" content={descripcion} />
		<meta property="og:title" content={titulo} />
		<meta property="og:description" content={descripcion} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_EC" />
		<meta property="og:image" content={imagen} />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<slot />
	</body>
</html>
