---
import '../styles/global.css';
const titulo = 'Somos Loja | El camino del café, de la finca a la taza';
const descripcion = 'Recorre el proceso del café en Loja y conoce Somos Loja, la tienda de emprendedores y productores locales.';
const imagen = '/carpeta-a-usar-web/paradas/parada-01.webp';
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" type="image/webp" href="/carpeta-a-usar-web/sello-100-cafe-especial.webp" />
		<link rel="preload" href="/fonts/manrope-latin-var.woff2" as="font" type="font/woff2" crossorigin />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#131209" />
		<meta name="color-scheme" content="dark" />
		<script is:inline>document.documentElement.classList.add("js")</script>
		<title>{titulo}</title>
		<meta name="description" content={descripcion} />
		<meta property="og:title" content={titulo} />
		<meta property="og:description" content={descripcion} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_EC" />
		<meta property="og:image" content={imagen} />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<slot />
	</body>
</html>
